# Personal Claude subscription auth (see README for why this is fine for a
# single-user local project but wrong for anything you'd distribute to others).
CLAUDE_CODE_OAUTH_TOKEN=

# Swap in an API key instead if you don't have a Claude subscription token:
# ANTHROPIC_API_KEY=

TARGET_BASE_URL=https://www.saucedemo.com
VIBIUM_HEADLESS=false

# Optional tracing to a local Arize Phoenix (see README "Observability").
# Leave blank to run without it; set to http://localhost:6006 to turn it on.
PHOENIX_COLLECTOR_ENDPOINT=
